# Public HTTPS origins used when generating account recovery links.
# Replace these example domains on every deployed environment, then rebuild
# Laravel's configuration cache before sending password-reset emails.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://attp.example.org
THINK_TANK_PORTAL_URL=https://think-tank.example.org
REQUIRE_LOGIN_OTP_LOCALLY=false

# Durable mail jobs: keep worker --timeout at or below 300 seconds and this
# retry window above it so an in-flight Graph request is never reserved twice.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=420

MAIL_MAILER=graph
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CERT_PATH=
MICROSOFT_PRIVATE_KEY_PATH=
MICROSOFT_GRAPH_FROM_ADDRESS=
MICROSOFT_GRAPH_TIMEOUT=30
MICROSOFT_GRAPH_CONNECT_TIMEOUT=10
MICROSOFT_GRAPH_RETRY_ATTEMPTS=1
MICROSOFT_GRAPH_RETRY_MAX_DELAY_MS=2000
MICROSOFT_GRAPH_CA_BUNDLE=
