# Public HTTPS origins used when generating account recovery links.
# Replace these example domains on every deployed environment, then rebuild
# Laravel's configuration cache before sending password-reset emails.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://attp.example.org
THINK_TANK_PORTAL_URL=https://think-tank.example.org

MAIL_MAILER=graph
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CERT_PATH=
MICROSOFT_PRIVATE_KEY_PATH=
MICROSOFT_GRAPH_FROM_ADDRESS=
