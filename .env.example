# Think Tank portal production boundary. Every value containing angle brackets
# is an intentionally invalid placeholder and MUST be replaced before deploy.
# Origins include the scheme and no path. Sanctum uses host[:port] only.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<laravel-public-host>
THINK_TANK_PORTAL_URL=https://<portal-public-host>
THINK_TANK_PORTAL_ALLOWED_ORIGINS=https://<portal-public-host>
SANCTUM_STATEFUL_DOMAINS=<portal-public-host>

# Use only the exact reverse-proxy IP addresses or bounded CIDRs that connect
# directly to PHP. Comma-separate multiple entries; never use *, **, 0.0.0.0,
# ::, REMOTE_ADDR, or an unrestricted network range.
THINK_TANK_TRUSTED_PROXIES=<exact-reverse-proxy-ip-or-cidr>

# These settings are enforced by think-tank:security:preflight in production.
THINK_TANK_PORTAL_REQUIRE_MFA=true
THINK_TANK_PORTAL_SHOW_LOCAL_OTP=false
REQUIRE_LOGIN_OTP_LOCALLY=false
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12
THINK_TANK_PORTAL_DUMMY_PASSWORD_HASH='$2y$12$IsdzQWyVSSHhdASAL3eTxOB.hnP7iF0GTKlF0SQpRImnWCEaUE8QO'

# Encrypted host-only cookies plus shared database sessions are mandatory.
# SESSION_DOMAIN must remain empty so Laravel does not issue a parent-domain
# cookie. SameSite=Strict is compatible with the portal's same-origin proxy.
SESSION_DRIVER=database
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_DOMAIN=
SESSION_SAME_SITE=strict
SESSION_PARTITIONED_COOKIE=false

# Rate limits and account email locks must use a store shared by every PHP
# process/node. These database defaults require cache and cache_locks tables.
CACHE_STORE=database
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks
THINK_TANK_PORTAL_LOCK_STORE=database

# Durable mail jobs: keep worker --timeout at or below 300 seconds and this
# retry window above it so an in-flight Graph request is never reserved twice.
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=420

MAIL_MAILER=graph
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CERT_PATH=
MICROSOFT_PRIVATE_KEY_PATH=
MICROSOFT_GRAPH_FROM_ADDRESS=
MICROSOFT_GRAPH_TIMEOUT=30
MICROSOFT_GRAPH_CONNECT_TIMEOUT=10
MICROSOFT_GRAPH_RETRY_ATTEMPTS=1
MICROSOFT_GRAPH_RETRY_MAX_DELAY_MS=2000
MICROSOFT_GRAPH_CA_BUNDLE=
